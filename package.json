{
  "name": "@ycniuqton/devlens",
  "version": "0.1.22",
  "publishConfig": {
    "access": "public"
  },
  "description": "Developer dashboard with real-time git diffs, task board, and external integrations",
  "bin": {
    "devlens": "./bin/devlens.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "diff",
    "dashboard",
    "kanban",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycniuqton/Devlens.git"
  },
  "homepage": "https://github.com/ycniuqton/Devlens#readme",
  "dependencies": {
    "@ycniuqton/devlens": "^0.1.13",
    "bcryptjs": "^3.0.3",
    "sql.js": "^1.12.0",
    "chokidar": "^3.6.0",
    "cloudflared": "^0.7.1",
    "commander": "^12.0.0",
    "cookie-parser": "^1.4.7",
    "diff2html": "^3.4.47",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "ngrok": "^4.3.3",
    "open": "^10.1.0",
    "simple-git": "~3.33.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/sql.js": "^1.4.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist/",
    "bin/",
    "public/"
  ]
